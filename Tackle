local function sounds()
    task.spawn(function()
        for i=1, 7 do
            task.wait(math.random(5, 30)/100)
            task.spawn(function()
                local sound = Instance.new("Sound")
                    
                sound.Volume = 20
                sound.SoundId = "rbxassetid://166047422"
                sound.Parent = game.SoundService
                sound.PlaybackSpeed = 0.8
                sound:Play()

                task.wait(1.2)
                sound:Destroy()
            end)
        end
    end)
end

