MyEntity:SetCallback("OnEnterRoom", function(room: Model, firstTime: boolean)
    local number = tonumber(room.Name)
    if firstTime == true and number <= game.ReplicatedStorage.GameData.DoorsOpened.Value then
        print("Entity has entered room: ".. room.Name.. " for the first time")
        for i, closet in ipairs(room.Assets:GetChildren()) do
            task.spawn(function()
                if closet.Name == "Wardrobe" then
                    for i, closetPart in ipairs(closet:GetDescendants()) do
                        if closetPart:IsA("MeshPart") then
                            closetPart.Anchored = false
                            closetPart.Position = closetPart.Position + Vector3.new(math.random(-2, 2), math.random(-2, 2), math.random(-2, 2))
                        elseif closetPart:IsA("Motor6D") or closetPart:IsA("ManualWeld") or closetPart:IsA("ProximityPrompt") then
                            closetPart:Destroy()
                        end
                    end
                    if closet.HiddenPlayer.Value.Humanoid then
                        local GameStats = game.ReplicatedStorage:WaitForChild("GameStats") :: Folder
                        closet.HiddenPlayer.Value.Humanoid.Health = 0
                        local LocalPlayer = game.Players.LocalPlayer

                        local cause = "Tackle [Don't hide !]"
                        GameStats["Player_".. LocalPlayer.Name].Total.DeathCause.Value = cause
                    end
                end
            end)
        end
    else
        print("Entity has entered room: ".. room.Name.. " again")
        for i, closet in ipairs(room.Assets:GetChildren()) do
            task.spawn(function()
                if closet.Name == "Wardrobe" then
                    for i, closetPart in ipairs(closet:GetDescendants()) do
                        if closetPart:IsA("MeshPart") then
                            closetPart.Massless = true
                            closetPart.Anchored = false
                            closetPart.Position = closetPart.Position + Vector3.new(math.random(-2, 2), math.random(-2, 2), math.random(-2, 2))
                        elseif closetPart:IsA("Motor6D") or closetPart:IsA("ManualWeld") then
                            closetPart:Destroy()
                        end
                    end
                    if closet.HiddenPlayer.Value.Humanoid then
                        local GameStats = game.ReplicatedStorage:WaitForChild("GameStats") :: Folder
                        closet.HiddenPlayer.Value.Humanoid.Health = 0
                        local LocalPlayer = game.Players.LocalPlayer

                        local cause = "Tackle"
                        GameStats["Player_".. LocalPlayer.Name].Total.DeathCause.Value = cause
                    end
                end
            end)
        end
    end
end)

